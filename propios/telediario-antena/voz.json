{
"T": 45.709,
"trozos": [
{
"i": 0,
"esc": 0,
"txt": "Última hora: un fontanero lleva tres días subido a una antena.",
"t0": 0.25,
"t1": 3.801,
"fx": null,
"ratio": 1.0
},
{
"i": 1,
"esc": 1,
"txt": "Se llama Paco, y esta semana ha perdido doce clientes por no coger el teléfono.",
"t0": 4.151,
"t1": 8.317,
"fx": null,
"ratio": 1.0
},
{
"i": 2,
"esc": 2,
"txt": "Y lo peor… todavía no había pasado.",
"t0": 8.667,
"t1": 10.426,
"fx": null,
"ratio": 1.0
},
{
"i": 3,
"esc": 3,
"txt": "Primero, se pegó el móvil a la frente con cinta americana.",
"t0": 10.776,
"t1": 13.505,
"fx": null,
"ratio": 1.0
},
{
"i": 4,
"esc": 3,
"txt": "El móvil acabó dentro del váter.",
"t0": 13.955,
"t1": 15.724,
"fx": null,
"ratio": 1.0
},
{
"i": 5,
"esc": 4,
"txt": "Después, contrató a un loro de secretario. El loro solo sabe decir:",
"t0": 16.124,
"t1": 20.52,
"fx": null,
"ratio": 1.0
},
{
"i": 6,
"esc": 4,
"txt": "¡Luego te llamo!",
"t0": 20.82,
"t1": 21.668,
"fx": "loro",
"ratio": 0.7509638554216868
},
{
"i": 7,
"esc": 5,
"txt": "Y hoy, se ha subido a una antena para tener más cobertura.",
"t0": 22.068,
"t1": 24.845,
"fx": null,
"ratio": 1.0
},
{
"i": 8,
"esc": 5,
"txt": "Cobertura tiene.",
"t0": 25.145,
"t1": 26.112,
"fx": null,
"ratio": 1.0
},
{
"i": 9,
"esc": 5,
"txt": "Escalera para bajar… no.",
"t0": 26.562,
"t1": 27.938,
"fx": null,
"ratio": 1.0
},
{
"i": 10,
"esc": 6,
"txt": "Mientras tanto, su vecino electricista no ha perdido ni una llamada.",
"t0": 28.488,
"t1": 31.681,
"fx": null,
"ratio": 1.0
},
{
"i": 11,
"esc": 6,
"txt": "¿Su secreto?",
"t0": 31.931,
"t1": 32.699,
"fx": null,
"ratio": 1.0
},
{
"i": 12,
"esc": 6,
"txt": "Una recepcionista con inteligencia artificial: coge llamadas, contesta WhatsApps y agenda citas. Las veinticuatro horas.",
"t0": 33.149,
"t1": 40.126,
"fx": null,
"ratio": 1.0
},
{
"i": 13,
"esc": 7,
"txt": "Paco sigue en la antena. Envíaselo a quien nunca coge el teléfono.",
"t0": 40.576,
"t1": 44.509,
"fx": null,
"ratio": 1.0
}
],
